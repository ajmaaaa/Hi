{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meyky-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "meyky-portfolio"
    }
  ],
  "routes": [
    {
      "pattern": "meykyajmariadi.xyz",
      "custom_domain": true
    },
    {
      "pattern": "www.meykyajmariadi.xyz",
      "custom_domain": true
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
